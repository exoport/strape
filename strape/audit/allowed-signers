# Keys permitted to sign strape release tags (git's SSH allowed-signers format).
#
# WHY THIS IS IN THE AUDIT RECORD, not ~/.ssh
# strape/audit/ answers "who cleared this tree, and how would you check?". Who may SIGN a release is the
# same class of question, so it belongs next to the review attestation rather than in one machine's dotfiles.
# Committed, so `git tag -v strape-v*` verifies against a reviewed list instead of whatever the local
# checkout happens to trust.
#
# Format: <principal> <key-type> <key>
# Point git at it with:  git config gpg.ssh.allowedSignersFile strape/audit/allowed-signers
#
# The release ARTIFACT is still unsigned — a .sha256 published beside it proves the download was not
# corrupted, not who produced it. Keyless sigstore signing in strape-release.yml is the backlog item that
# closes that; this file only makes the tag verifiable.
diegos@exo.com.ar ssh-rsa  id_rsa_202010: diegos@exo.com.ar
